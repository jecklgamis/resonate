{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jecklgamis/resonate/main/internal/config/scenario.schema.json",
  "title": "Resonate scenario",
  "description": "YAML scenario configuration accepted by `resonate run`. Print this schema with `resonate schema`.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "enum": ["http", "ws", "grpc", "sse"],
      "default": "http",
      "description": "Scenario protocol. Defaults to HTTP."
    },
    "load": {
      "$ref": "#/$defs/load"
    },
    "http": {
      "$ref": "#/$defs/http"
    },
    "ws": {
      "$ref": "#/$defs/websocket"
    },
    "grpc": {
      "$ref": "#/$defs/grpc"
    },
    "sse": {
      "$ref": "#/$defs/sse"
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    }
  },
  "required": ["load"],
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol": {
            "const": "ws"
          }
        },
        "required": ["protocol"]
      },
      "then": {
        "required": ["ws"],
        "not": {
          "anyOf": [
            {
              "required": ["http"]
            },
            {
              "required": ["grpc"]
            },
            {
              "required": ["sse"]
            }
          ]
        }
      },
      "else": {
        "if": {
          "properties": {
            "protocol": {
              "const": "grpc"
            }
          },
          "required": ["protocol"]
        },
        "then": {
          "required": ["grpc"],
          "not": {
            "anyOf": [
              {
                "required": ["http"]
              },
              {
                "required": ["ws"]
              },
              {
                "required": ["sse"]
              }
            ]
          }
        },
        "else": {
          "if": {
            "properties": {
              "protocol": {
                "const": "sse"
              }
            },
            "required": ["protocol"]
          },
          "then": {
            "required": ["sse"],
            "not": {
              "anyOf": [
                {
                  "required": ["http"]
                },
                {
                  "required": ["ws"]
                },
                {
                  "required": ["grpc"]
                }
              ]
            }
          },
          "else": {
            "required": ["http"],
            "not": {
              "anyOf": [
                {
                  "required": ["ws"]
                },
                {
                  "required": ["grpc"]
                },
                {
                  "required": ["sse"]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "duration": {
      "type": "string",
      "minLength": 1,
      "description": "A Go time.Duration string, for example 500ms, 5s, or 2m."
    },
    "numberOrString": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "identity": {
      "$ref": "#/$defs/stringMap",
      "description": "Values exposed to request templates as .Identity.<name>."
    },
    "feeder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Path to a CSV file (header row required) or JSON array of flat objects."
        },
        "mode": {
          "type": "string",
          "enum": ["sequential", "random", "stream"],
          "default": "sequential",
          "description": "Row selection mode. Sequential wraps around; stream reads incrementally."
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
          "description": "Inline rows (an array feeder), each a column-to-value map, instead of a file. mode may be sequential or random, not stream."
        },
        "kafka": {
          "$ref": "#/$defs/kafkaFeeder",
          "description": "Consume a Kafka topic instead of reading a file."
        }
      },
      "oneOf": [
        { "required": ["file"], "not": { "anyOf": [{ "required": ["kafka"] }, { "required": ["rows"] }] } },
        { "required": ["rows"], "not": { "anyOf": [{ "required": ["file"] }, { "required": ["kafka"] }, { "properties": { "mode": { "const": "stream" } }, "required": ["mode"] }] } },
        { "required": ["kafka"], "not": { "anyOf": [{ "required": ["file"] }, { "required": ["rows"] }, { "required": ["mode"] }] } }
      ]
    },
    "kafkaFeeder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brokers", "topic"],
      "properties": {
        "brokers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Seed brokers, host:port." },
        "topic": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "enum": ["json", "raw"], "default": "json", "description": "json: the message value is a JSON object whose top-level fields become columns. raw: only the _-prefixed metadata columns." },
        "from": { "type": "string", "enum": ["start", "end"], "default": "start" },
        "on_end": { "type": "string", "enum": ["wrap", "wait"], "description": "Default wrap when from is start, wait when from is end. wrap needs from: start." },
        "timeout": { "$ref": "#/$defs/duration", "description": "Connecting and waiting for the first message. Default 10s." },
        "tls": { "type": "boolean" },
        "insecure": { "type": "boolean" },
        "ca_file": { "type": "string" },
        "cert_file": { "type": "string" },
        "key_file": { "type": "string" },
        "sasl_mechanism": { "type": "string", "enum": ["PLAIN", "SCRAM-SHA-256", "SCRAM-SHA-512"] },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "password_env": { "type": "string", "description": "Environment variable holding the password." }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "$ref": "#/$defs/duration",
          "description": "Stop after this duration. Combined with requests, whichever is reached first stops the run."
        },
        "requests": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of iterations."
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "description": "Target iteration start rate per second; 0 means unpaced."
        },
        "workers": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of concurrent virtual users."
        },
        "max_workers": {
          "type": "integer",
          "minimum": 0,
          "description": "Concurrency ceiling for rate-driven load. Requires rate > 0 unless stages is set."
        },
        "iterations": {
          "type": "integer",
          "minimum": 0,
          "description": "Iterations per virtual user before that user is replaced. Alone, requires workers and runs exactly workers * iterations."
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "description": "Ramp schedule; replaces flat duration/rate/workers settings.",
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      },
      "anyOf": [
        {
          "required": ["duration"]
        },
        {
          "required": ["requests"]
        },
        {
          "required": ["iterations"]
        },
        {
          "required": ["stages"]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "max_workers": {
                "minimum": 1
              }
            },
            "required": ["max_workers"]
          },
          "then": {
            "anyOf": [
              {
                "required": ["stages"]
              },
              {
                "required": ["rate"],
                "properties": {
                  "rate": {
                    "exclusiveMinimum": 0
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "string",
          "description": "Stage duration; omitted or 0 makes an instantaneous jump."
        },
        "workers": {
          "type": "integer",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "description": "Target iteration rate at the end of the stage."
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "description": "Independent requests, selected round-robin per iteration.",
          "items": {
            "$ref": "#/$defs/request"
          }
        },
        "flow": {
          "type": "array",
          "minItems": 1,
          "description": "Ordered requests run per iteration; extracted values are available as .Vars.<name> in later steps.",
          "items": {
            "$ref": "#/$defs/flowEntry"
          }
        },
        "setup": {
          "type": "array",
          "minItems": 1,
          "description": "Steps run once per virtual user before its first flow iteration.",
          "items": {
            "$ref": "#/$defs/flowEntry"
          }
        },
        "identities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identity"
          },
          "description": "Sticky per-virtual-user template data; only used with flow."
        },
        "feeder": {
          "$ref": "#/$defs/feeder"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "description": "Prepended to request URLs that start with /."
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "insecure": {
          "type": "boolean",
          "description": "Skip TLS certificate verification."
        },
        "no_follow_redirects": {
          "type": "boolean"
        },
        "max_idle_conns": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum idle connections per target host; 0 uses Go's default."
        },
        "max_response_body": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum response body bytes read and counted per request; 0 is unlimited."
        },
        "cert_file": {
          "type": "string"
        },
        "key_file": {
          "type": "string"
        },
        "ca_file": {
          "type": "string"
        },
        "h2c": {
          "type": "boolean",
          "description": "Use prior-knowledge HTTP/2 over plaintext; mutually exclusive with TLS options, http3 and disable_keepalive."
        },
        "http3": {
          "type": "boolean",
          "description": "Use HTTP/3 (QUIC over UDP) for every request. Every url must be https://. Mutually exclusive with h2c and disable_keepalive."
        },
        "disable_keepalive": {
          "type": "boolean",
          "description": "Disable connection reuse; mutually exclusive with h2c and http3."
        }
      },
      "oneOf": [
        {
          "required": ["targets"],
          "not": {
            "required": ["flow"]
          }
        },
        {
          "required": ["flow"],
          "not": {
            "required": ["targets"]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": ["setup"]
              },
              {
                "required": ["identities"]
              }
            ]
          },
          "then": {
            "required": ["flow"]
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "description": "HTTP method; defaults to GET."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute URL, or a path beginning with / when http.base_url is set. Supports templates."
        },
        "query": {
          "$ref": "#/$defs/stringMap"
        },
        "headers": {
          "$ref": "#/$defs/stringMap"
        },
        "body": {
          "type": "string",
          "description": "Request body template."
        },
        "body_file": {
          "type": "string",
          "description": "Path to a request body file; its contents are templated."
        },
        "raw_body_file": {
          "type": "string",
          "description": "Path to request body bytes sent without templating."
        },
        "extract": {
          "$ref": "#/$defs/stringMap",
          "description": "Flow/setup only: map variable names to extraction rules (json:, yaml:, xml:, regex:, css:, header:, or status); ignored on independent targets."
        },
        "pause": {
          "$ref": "#/$defs/duration",
          "description": "Flow/setup only: think time before this request; ignored on independent targets."
        },
        "pause_max": {
          "$ref": "#/$defs/duration",
          "description": "Flow/setup only: upper bound for a random pause when greater than pause; ignored on independent targets."
        },
        "expect_status": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "expect_headers": {
          "$ref": "#/$defs/stringMap"
        },
        "expect_body": {
          "$ref": "#/$defs/stringMap",
          "description": "Map extraction rules to expected values; empty values only require the rule to resolve."
        }
      },
      "required": ["url"],
      "not": {
        "anyOf": [
          {
            "required": ["body", "raw_body_file"]
          },
          {
            "required": ["body_file", "raw_body_file"]
          }
        ]
      }
    },
    "flowEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "$ref": "#/$defs/controlBlock"
        }
      ]
    },
    "controlBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "during": {
          "$ref": "#/$defs/duration"
        },
        "if": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/flowEntry"
          }
        }
      },
      "required": ["steps"],
      "oneOf": [
        {
          "required": ["repeat"],
          "not": {
            "anyOf": [
              {
                "required": ["during"]
              },
              {
                "required": ["if"]
              }
            ]
          }
        },
        {
          "required": ["during"],
          "not": {
            "anyOf": [
              {
                "required": ["repeat"]
              },
              {
                "required": ["if"]
              }
            ]
          }
        },
        {
          "required": ["if"],
          "not": {
            "anyOf": [
              {
                "required": ["repeat"]
              },
              {
                "required": ["during"]
              }
            ]
          }
        }
      ]
    },
    "websocket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(wss?://|\\{\\{)",
          "description": "WebSocket URL; supports templates."
        },
        "headers": {
          "$ref": "#/$defs/stringMap"
        },
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "feeder": {
          "$ref": "#/$defs/feeder"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/wsMessage"
          }
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "insecure": {
          "type": "boolean"
        }
      },
      "required": ["url", "messages"]
    },
    "grpc": {
      "type": "object",
      "additionalProperties": false,
      "description": "gRPC calls (unary and streaming), made in order each iteration over a shared connection; the iteration stops at the first failed call. The schema comes from proto_files, else descriptor_set, else server reflection.",
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1,
          "description": "Server address, host:port."
        },
        "plaintext": {
          "type": "boolean",
          "description": "Connect without TLS. Mutually exclusive with insecure, ca_file, cert_file and key_file."
        },
        "insecure": {
          "type": "boolean",
          "description": "Skip TLS certificate verification."
        },
        "ca_file": {
          "type": "string"
        },
        "cert_file": {
          "type": "string"
        },
        "key_file": {
          "type": "string"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "connections": {
          "type": "integer",
          "minimum": 1,
          "description": "Spread virtual users over this many gRPC connections (default 1). A server typically allows ~100 concurrent streams per connection; raise this at high concurrency."
        },
        "proto_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": ".proto sources to compile. Mutually exclusive with descriptor_set."
        },
        "import_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Roots that proto_files and their imports resolve against; defaults to the directories containing proto_files."
        },
        "descriptor_set": {
          "type": "string",
          "description": "A FileDescriptorSet file from protoc --descriptor_set_out=FILE --include_imports. Mutually exclusive with proto_files."
        },
        "metadata": {
          "$ref": "#/$defs/stringMap"
        },
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "feeder": {
          "$ref": "#/$defs/feeder"
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/grpcCall"
          }
        }
      },
      "required": ["address", "calls"]
    },
    "grpcCall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^/?[^/\\s]+/[^/\\s]+$",
          "description": "package.Service/Method."
        },
        "message": {
          "type": "string",
          "description": "Request as protobuf JSON; supports templates. Empty means the empty message."
        },
        "message_file": {
          "type": "string",
          "description": "Path to a request message file; its contents are templated. Takes priority over message."
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Requests of a client-streaming or bidirectional call, sent in order; each supports templates and is rendered as it is sent."
        },
        "repeat": {
          "type": "integer",
          "minimum": 0,
          "description": "How many times to send the messages list (default 1)."
        },
        "send_interval": {
          "$ref": "#/$defs/duration"
        },
        "receive": {
          "type": "integer",
          "minimum": 0,
          "description": "For server-streaming and bidirectional calls: end successfully after this many responses. The server closing the stream first is a failure."
        },
        "duration": {
          "$ref": "#/$defs/duration"
        },
        "metadata": {
          "$ref": "#/$defs/stringMap"
        },
        "extract": {
          "$ref": "#/$defs/stringMap"
        },
        "expect_code": {
          "type": "array",
          "items": {
            "enum": [
              "OK", "CANCELLED", "CANCELED", "UNKNOWN", "INVALID_ARGUMENT", "DEADLINE_EXCEEDED",
              "NOT_FOUND", "ALREADY_EXISTS", "PERMISSION_DENIED", "RESOURCE_EXHAUSTED",
              "FAILED_PRECONDITION", "ABORTED", "OUT_OF_RANGE", "UNIMPLEMENTED", "INTERNAL",
              "UNAVAILABLE", "DATA_LOSS", "UNAUTHENTICATED"
            ]
          },
          "description": "gRPC status names that count as success; replaces the OK-only default."
        },
        "expect_body": {
          "$ref": "#/$defs/stringMap"
        }
      },
      "required": ["method"]
    },
    "sse": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Server-Sent Events stream, opened fresh every iteration and read until events and/or duration is reached.",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://|\\{\\{)",
          "description": "Stream URL; supports templates."
        },
        "method": {
          "type": "string",
          "description": "HTTP method; defaults to GET."
        },
        "query": {
          "$ref": "#/$defs/stringMap"
        },
        "headers": {
          "$ref": "#/$defs/stringMap"
        },
        "body": {
          "type": "string",
          "description": "Request body template."
        },
        "body_file": {
          "type": "string",
          "description": "Path to a request body file; its contents are templated."
        },
        "raw_body_file": {
          "type": "string",
          "description": "Path to a request body file sent as-is, without templating. Takes priority over body and body_file."
        },
        "events": {
          "type": "integer",
          "minimum": 0,
          "description": "End the stream successfully after this many events; the stream closing or duration/timeout elapsing first is a failure. 0 means no event target."
        },
        "duration": {
          "$ref": "#/$defs/duration"
        },
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "feeder": {
          "$ref": "#/$defs/feeder"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "insecure": {
          "type": "boolean"
        },
        "max_response_body": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum bytes read per stream; 0 is unlimited."
        },
        "cert_file": {
          "type": "string"
        },
        "key_file": {
          "type": "string"
        },
        "ca_file": {
          "type": "string"
        },
        "h2c": {
          "type": "boolean",
          "description": "Use prior-knowledge HTTP/2 over plaintext; mutually exclusive with TLS options and http3."
        },
        "http3": {
          "type": "boolean",
          "description": "Use HTTP/3 (QUIC over UDP). The url must be https://. Mutually exclusive with h2c."
        }
      },
      "required": ["url"]
    },
    "wsMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string",
          "description": "Message body template."
        },
        "binary": {
          "type": "boolean",
          "description": "Send as a binary frame instead of text."
        },
        "wait": {
          "type": "boolean",
          "description": "Wait for one response frame."
        },
        "extract": {
          "$ref": "#/$defs/stringMap",
          "description": "Extract response frame values for later messages; requires wait: true."
        },
        "expect_body": {
          "$ref": "#/$defs/stringMap",
          "description": "Check the response frame; requires wait: true."
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": ["extract"]
              },
              {
                "required": ["expect_body"]
              }
            ]
          },
          "then": {
            "properties": {
              "wait": {
                "const": true
              }
            },
            "required": ["wait"]
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^(requests|success|success_rate|error_rate|rate|latency_(min|mean|stddev|max|p(100(\\.0+)?|([0-9]|[1-9][0-9])(\\.[0-9]+)?)))$",
          "description": "Metric to evaluate; percentile metrics may use latency_p<N>, where N is between 0 and 100."
        },
        "min": {
          "$ref": "#/$defs/numberOrString"
        },
        "max": {
          "$ref": "#/$defs/numberOrString"
        },
        "gt": {
          "$ref": "#/$defs/numberOrString"
        },
        "lt": {
          "$ref": "#/$defs/numberOrString"
        },
        "is": {
          "$ref": "#/$defs/numberOrString"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/numberOrString"
          }
        },
        "around": {
          "$ref": "#/$defs/numberOrString"
        },
        "around_margin": {
          "$ref": "#/$defs/numberOrString"
        },
        "around_exclusive": {
          "type": "boolean"
        },
        "deviates_around": {
          "$ref": "#/$defs/numberOrString"
        },
        "deviates_percent": {
          "$ref": "#/$defs/numberOrString",
          "description": "Percentage margin; for example 10 means plus or minus 10%."
        },
        "deviates_exclusive": {
          "type": "boolean"
        }
      },
      "required": ["metric"],
      "anyOf": [
        {
          "required": ["min"]
        },
        {
          "required": ["max"]
        },
        {
          "required": ["gt"]
        },
        {
          "required": ["lt"]
        },
        {
          "required": ["is"]
        },
        {
          "required": ["in"]
        },
        {
          "required": ["around", "around_margin"]
        },
        {
          "required": ["deviates_around", "deviates_percent"]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": ["around"]
          },
          "then": {
            "required": ["around_margin"]
          }
        },
        {
          "if": {
            "required": ["around_margin"]
          },
          "then": {
            "required": ["around"]
          }
        },
        {
          "if": {
            "required": ["deviates_around"]
          },
          "then": {
            "required": ["deviates_percent"]
          }
        },
        {
          "if": {
            "required": ["deviates_percent"]
          },
          "then": {
            "required": ["deviates_around"]
          }
        }
      ]
    }
  }
}
